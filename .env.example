# Copy this file to .env and fill in your own values.
# The .env file must never be committed to GitHub.

# From Atlas: Connect -> Drivers -> Python. Replace <db_password> with your
# database user's password (angle brackets included).
MONGODB_URI=mongodb+srv://appuser:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

DB_NAME=SignUp
COLLECTION_NAME=users
